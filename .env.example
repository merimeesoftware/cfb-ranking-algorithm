# CFB Ranking System — Environment Variables (local dev only)
# Copy to .env for local development. Cloud Agents use the Cursor Secrets tab — see .cursor/SECRETS.md

# Required for live CFBD pulls: https://collegefootballdata.com/key
# Free tier = 1,000 calls/month per account — prefer offline + static rankings locally.
CFBD_API_KEY=your_cfbd_api_key_here
# Optional second CFBD account (separate 1k/mo quota). Flip with CFBD_API_KEY_SLOT=B.
# CFBD_API_KEY_B=your_second_cfbd_api_key_here
# CFBD_API_KEY_SLOT=A

# --- Local testing spend limits (recommended) ---
# CFBD_OFFLINE=1 → zero CFBD (static + cache). Set 0 to allow live pulls under the cap.
CFBD_OFFLINE=1
# Live CFBD call budget this process per UTC day.
# Production wrangler sets 4. Unset code fallback is still 25. Never unlimited.
# 4/day × 31 + cron 24×52/12 = 228, under the 900 free-tier ceiling.
CFBD_MAX_CALLS=4

# AI_MODE=off|stub|live
# stub is the local and preview default. live uses xAI or Workers AI under a daily cap.
AI_MODE=stub
# Live prompt budgets, per provider, per UTC day. Production and the code default are 0.
XAI_MAX_CALLS=0
WORKERS_AI_MAX_CALLS=0
# workers_ai (default) or xai. Used when AI_MODE=live and the request omits provider.
# AI_PROVIDER=workers_ai
# /agent/explain requests per IP per hour (stub+live+off all count)
AGENT_RATE_LIMIT=50

# XAI_API_KEY is a Cloudflare secret name only.
# It is provisioned by DevSecOps on Michael's yes.
# Do not put a value in this file.
# Live calls go through AI Gateway (logging only). Budgets stay on spend-budget.
# Worker vars, not local secrets: CF_ACCOUNT_ID and AI_GATEWAY_ID=true-rankings.
# xAI: https://gateway.ai.cloudflare.com/v1/{CF_ACCOUNT_ID}/{AI_GATEWAY_ID}/grok/...
# Workers AI: env.AI.run(..., { gateway: { id: AI_GATEWAY_ID } }).
# Release Ops creates AI Gateway true-rankings in the account.

# Optional: enable POST /cache/clear in production (disabled if unset)
# CACHE_CLEAR_SECRET=your_cache_clear_secret_here

# The Drop newsletter ESP webhook (Buttondown / Mailchimp / Beehiiv). Unset = accept-only in API.
# DROP_WEBHOOK_URL=https://api.example.com/subscribe

# Public site origin for citations / sitemap generation
# PUBLIC_SITE_URL=https://truerankings.com

# Optional overrides
# CACHE_DIR=/tmp/cfb-cache
# CORS_ORIGINS=https://your-pages-domain.pages.dev

FLASK_ENV=development
PORT=5001

# --- Docker Compose local smoke (optional) ---
# docker compose up --build
# Frontend: http://localhost:5173  API: http://localhost:5001
# Compose defaults to CFBD_OFFLINE=1 and AI_MODE=stub.
