# CFB Ranking System — Environment Variables (local dev only)
# Copy to .env for local development. Cloud Agents use the Cursor Secrets tab — see .cursor/SECRETS.md

# Required for live CFBD pulls: https://collegefootballdata.com/key
# Free tier = 1,000 calls/month — prefer offline + static rankings locally.
CFBD_API_KEY=your_cfbd_api_key_here

# --- Local testing spend limits (recommended) ---
# CFBD_OFFLINE=1 → zero CFBD (static + cache). Set 0 to allow live pulls under the cap.
CFBD_OFFLINE=1
# Live CFBD call budget this process (development default 25 if unset)
CFBD_MAX_CALLS=25

# AI_MODE=off|stub|live
# stub = free template prose (no MiniMax). live = paygo MiniMax only.
AI_MODE=stub
# Live MiniMax prompt budget this process (development default 25 if unset)
AI_MAX_CALLS=25
# /agent/explain requests per IP per hour (stub+live+off all count)
AGENT_RATE_LIMIT=50

# Optional: live /agent/explain (pay-as-you-go MiniMax key — NOT Coding Plan / OpenCode)
# MINIMAX_API_KEY=your_minimax_paygo_key_here

# Optional: enable POST /cache/clear in production (disabled if unset)
# CACHE_CLEAR_SECRET=your_cache_clear_secret_here

# Optional overrides
# CACHE_DIR=/tmp/cfb-cache
# CORS_ORIGINS=https://your-pages-domain.pages.dev

FLASK_ENV=development
PORT=5001

# --- Docker Compose local smoke (optional) ---
# docker compose up --build
# Frontend: http://localhost:5173  API: http://localhost:5001
# Compose reads this file; set CFBD_OFFLINE=0 and AI_MODE=live for live smoke.
