# CFB Ranking System — Environment Variables
# Copy to .env and fill in values (never commit .env)

# Required: College Football Data API key (https://collegefootballdata.com/key)
CFBD_API_KEY=your_cfbd_api_key_here

# Optional: MiniMax API key for OpenCode agent workflows and gh-aw CI agents
# Get from https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=your_minimax_api_key_here

# Optional: Protect POST /cache/clear in production
CACHE_CLEAR_SECRET=your_cache_clear_secret_here

# Optional: Override cache directory (use R2-backed path in Cloudflare Containers)
# CACHE_DIR=/tmp/cfb-cache

# Optional: Cloudflare deployment (GitHub Actions secrets)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Frontend build-time (Cloudflare Pages / Render)
# VITE_API_URL=https://your-api-host.example.com

# Flask
FLASK_ENV=development
PORT=5001
