{
  // OpenCode configuration for CFB Ranking System CI and local agent workflows
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M2.7",
  "provider": {
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}",
        "baseURL": "https://api.minimax.io/anthropic"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "webfetch": "allow",
    "mcp": "allow"
  },
  "agent": {
    "max_concurrent_tasks": 2
  }
}
